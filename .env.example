# SOCMind 系统配置
# 复制此文件为 .env 并修改对应值

# Flask 环境: development / production / testing
FLASK_ENV=development

# 密钥 - 生产环境请改为随机字符串
SECRET_KEY=socmind-docker-secret-key-change-in-production

# 数据库连接
# SQLite (开发用):
# DATABASE_URL=sqlite:///socmind.db
# MySQL (生产推荐):
DATABASE_URL=mysql+pymysql://root:1@localhost:3306/socmind?charset=utf8mb4

# OpenAI API (可选，用于 AI 研判)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com

# 上传目录
UPLOAD_FOLDER=uploads

# 服务端口 (仅开发模式)
FLASK_PORT=5000
FLASK_HOST=0.0.0.0

# Gunicorn 配置 (生产模式)
GUNICORN_WORKERS=2
GUNICORN_TIMEOUT=120
